{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpalazon-dev/portable-opencode/schemas/context-document.schema.json",
  "title": "Portable OpenCode curated document frontmatter",
  "description": "Schema for parsed YAML frontmatter of non-reserved curated Markdown documents.",
  "type": "object",
  "required": [
    "type",
    "title",
    "description",
    "status"
  ],
  "properties": {
    "type": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^(RESEARCH|DESIGN|FEAT|SPIKE)-[0-9]{3}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "proposed",
        "draft",
        "deferred",
        "superseded",
        "deprecated",
        "archived"
      ]
    },
    "decision": {
      "type": "string",
      "pattern": "^DEC-[0-9]{3}$"
    },
    "resource": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource"
        ],
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "by",
        "at"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
