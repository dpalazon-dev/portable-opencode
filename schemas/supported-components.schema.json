{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://portable-opencode.local/schemas/supported-components.schema.json",
  "title": "Portable OpenCode Supported Components",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "platform", "components"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "shell"],
      "properties": {
        "os": {"type": "string", "const": "windows-native"},
        "shell": {"type": "string", "const": "powershell"},
        "windows_version": {"type": ["string", "null"]},
        "powershell_version": {"type": ["string", "null"]},
        "evidence_state": {"$ref": "#/$defs/evidenceState"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "evidenceState": {
      "type": "string",
      "enum": ["pending", "validated", "rejected", "deferred"]
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "required",
        "supported_version",
        "installation_mechanism",
        "evidence_state",
        "evidence_source",
        "upgrade_policy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "type": "string",
          "enum": ["cli", "runtime", "backend", "integration", "remote-service"]
        },
        "required": {"type": "boolean"},
        "supported_version": {"type": ["string", "null"]},
        "version_constraint": {"type": ["string", "null"]},
        "installation_source": {"type": ["string", "null"]},
        "installation_mechanism": {"type": ["string", "null"]},
        "platform_constraints": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "evidence_state": {"$ref": "#/$defs/evidenceState"},
        "evidence_source": {"type": "string", "minLength": 1},
        "upgrade_policy": {
          "type": "string",
          "enum": ["pinned", "validated-range", "remote-contract", "pending"]
        },
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evidence_state": {"const": "validated"},
              "kind": {"not": {"const": "remote-service"}}
            },
            "required": ["evidence_state", "kind"]
          },
          "then": {
            "properties": {
              "supported_version": {"type": "string", "minLength": 1},
              "installation_mechanism": {"type": "string", "minLength": 1}
            }
          }
        },
        {
          "if": {
            "properties": {"kind": {"const": "remote-service"}},
            "required": ["kind"]
          },
          "then": {
            "properties": {
              "upgrade_policy": {"const": "remote-contract"},
              "installation_mechanism": {"type": "null"}
            }
          }
        }
      ]
    }
  }
}
