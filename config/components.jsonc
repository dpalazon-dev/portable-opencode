    },
    {
      "id": "graphify",
      "kind": "cli",
      "required": true,
      "supported_version": "0.9.56",
      "version_constraint": "==0.9.56",
      "installation_source": "https://pypi.org/project/graphifyy/0.9.56/",
      "installation_mechanism": "Python 3.12 isolated venv plus python.exe -m pip install graphifyy==0.9.56; invoke graphify.exe from Scripts",
      "platform_constraints": ["windows-native"],
      "evidence_state": "validated",
      "evidence_source": "SPIKE-004",
      "upgrade_policy": "pinned",
      "notes": "Native install, explicit code extraction, ignore semantics, clone/update and relative-path manifest portability were evidenced in disposable fixtures. Deterministic reports require PYTHONHASHSEED=0 and corrupt-graph recovery requires a full rebuild; hooks remain deferred; no Graphify MCP is part of core."
    },
    {
      "id": "rtk",
      "kind": "integration",
      "required": true,
      "supported_version": "0.48.0",
      "version_constraint": "==0.48.0",
      "installation_source": "https://github.com/rtk-ai/rtk/releases/tag/v0.48.0",
      "installation_mechanism": "winget download --id rtk-ai.rtk --exact --version v0.48.0; extract rtk-x86_64-pc-windows-msvc.zip and place rtk.exe on PATH",
      "platform_constraints": ["windows-native", "opencode-integration"],
      "evidence_state": "validated",
      "evidence_source": "SPIKE-004",
      "upgrade_policy": "pinned",
      "notes": "Native binary identity, rewrite registry, exclusions, private failure tee and degraded OpenCode loading passed. Upstream integration is %USERPROFILE%\\.config\\opencode\\plugins\\rtk.ts; provider-backed tool invocation was not tested."
    }
  ]
