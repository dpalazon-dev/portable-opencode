      "version_constraint": null,
      "installation_source": "https://openrouter.ai",
      "installation_mechanism": null,
      "platform_constraints": [],
      "evidence_state": "pending",
      "evidence_source": "SPIKE-002",
      "upgrade_policy": "remote-contract",
      "notes": "Tracked as an API contract rather than an installed binary. SPIKE-002 documented the v1 preset surfaces and local normalization boundary, but authenticated lifecycle, OpenCode preset invocation, tools, routing, privacy inspection and live usage fields remain unverified; keep evidence pending."
    },
    {
      "id": "phoenix",
      "kind": "backend",
      "required": true,
      "supported_version": null,
      "version_constraint": null,
      "installation_source": null,
