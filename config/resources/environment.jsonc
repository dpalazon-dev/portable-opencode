{
  "$schema": "../../schemas/resource-catalog.schema.json",
  "schema_version": "0.1.0",
  "scope": "environment",
  "resources": [
    {
      "schema_version": "0.1.0",
      "resource_id": "env.opencode.config",
      "scope": "environment",
      "canonical_source": {"kind": "repository-path", "path": "config/global/opencode.jsonc", "reference": null},
      "managed_target": {"kind": "filesystem", "path": "%USERPROFILE%\\.config\\opencode\\opencode.jsonc", "locator": "evidence-gated-by-SPIKE-001"},
      "owner": "portable-opencode",
      "materialization_mode": "rendered",
      "mutability": "portable-managed",
      "content_identity": {"strategy": "normalized-jsonc", "desired": null, "observed": null},
      "backup_policy": "required-before-replace",
      "drift_policy": "block-on-ambiguity",
      "verification": [
        {"id": "schema", "kind": "schema", "blocking": true, "description": "Generated JSONC is valid."},
        {"id": "upstream-load", "kind": "upstream-load", "blocking": true, "description": "OpenCode loads the intended global config."}
      ],
      "ownership_state": "unmanaged",
      "version_policy": {"component_id": "opencode", "required_state": "evidence-pending"}
    },
    {
      "schema_version": "0.1.0",
      "resource_id": "env.opencode.rules",
      "scope": "environment",
      "canonical_source": {"kind": "repository-path", "path": "config/global/AGENTS.md", "reference": null},
