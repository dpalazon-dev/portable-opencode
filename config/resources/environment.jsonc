      "owner": "portable-opencode",
      "materialization_mode": "copied",
      "mutability": "portable-managed",
      "content_identity": {"strategy": "sha256", "desired": null, "observed": null},
      "backup_policy": "required-before-replace",
      "drift_policy": "block-on-ambiguity",
      "verification": [
        {"id": "content", "kind": "content-match", "blocking": true, "description": "Target matches canonical rules."},
        {"id": "upstream-load", "kind": "upstream-load", "blocking": true, "description": "OpenCode discovers global rules."}
      ],
      "ownership_state": "unmanaged",
      "version_policy": {"component_id": "opencode", "required_state": "evidence-pending"}
    },
    {
